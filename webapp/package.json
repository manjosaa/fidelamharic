{
  "name": "responsive-webapp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "electron-main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "electron .",
    "electron:prod": "npm run build && electron .",
    "dist": "npm run build && electron-builder --win --x64"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "vite": "^6.4.3",
    "@vitejs/plugin-react": "^5.2.0",
    "vite-plugin-pwa": "^1.0.0",
    "electron": "^26.0.0",
    "electron-builder": "^24.7.0"
  },
  "build": {
    "appId": "com.manjosaa.responsivewebapp",
    "files": [
      "dist/**/*",
      "electron-main.cjs",
      "preload.cjs",
      "package.json"
    ],
    "win": {
      "target": ["nsis"]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "directories": {
      "buildResources": "build"
    }
  }
}
